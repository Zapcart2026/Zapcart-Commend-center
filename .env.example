# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Operations agents. Accuracy matters more than cost here.
CLAUDE_MODEL=claude-opus-5-5

# Marketing agent only. Set to whatever model your OpenAI account has.
OPENAI_MODEL=gpt-4o

PORT=8080
# Anyone with this value can use the dashboard. Make it long.
WORKSPACE_TOKEN=change-me-to-a-long-random-string

# Set to 1 to let the scheduler run agents. 0 = dashboard only, nothing fires.
SCHEDULER_ENABLED=0
